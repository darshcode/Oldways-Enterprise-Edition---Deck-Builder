@model IEnumerable<IGrouping<string, OldWays.Models.Service>>

@{
    ViewData["Title"] = "Services";
}

<h2>@ViewData["Title"]</h2>

@if(User.IsInRole("Admin")){
    <div class="mb-4">
        <a asp-controller="Service" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Service
        </a>
    </div>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search services..." />
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
</form>
@if (!string.IsNullOrWhiteSpace(Context.Request.Query["search"]))
{
    <p>
        <a asp-action="Index" class="btn btn-sm btn-link">Clear search</a>
    </p>
}



@foreach (var group in Model)
{
    <h3 class="mt-5 mb-3 border-bottom pb-1 text-secondary">@group.Key</h3>

    <div class="row">
        @foreach (var service in group)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@service.Name</h5>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-primary"></i>@service.Description
                            
                        </div>

                        <div class="d-flex justify-content-between mt-auto">
                            <strong>$@service.Price</strong>
                            <span class="text-muted small">Est. Time: @(string.IsNullOrWhiteSpace(service.Time) ? "TBD" : service.Time)</span>
                        </div>

                        
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="px-3 pb-3">
                                <input type="hidden" name="id" value="@service.Id" />
                                <div class="input-group">
                                    <input type="number" name="quantity" value="1" min="1" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </button>
                                </div>
                            </form>
                        

                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between px-3 pb-3">
                            <a asp-action="Edit" asp-route-id="@service.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@service.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}