@model List<OldWays.Models.Slideshow>


<div class="container">
    <h2>Slideshows</h2>

    @if (User.IsInRole("Admin"))
    {
        <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createSlideshowModal">
            Create New Slideshow
        </button>
    }

    <!-- Create Slideshow Modal -->
    <!-- ... your modal code stays the same ... -->
    @foreach (var slideshow in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between">
                <h4>@slideshow.Name</h4>

                <div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Slideshow" asp-action="Edit" asp-route-id="@slideshow.Id"
                           class="btn btn-warning btn-sm">Edit</a>

                        <a asp-controller="Slideshow" asp-action="Delete" asp-route-id="@slideshow.Id"
                           class="btn btn-danger btn-sm">Delete</a>
                    }
                </div>
            </div>

            <div class="card-body">
                <p>@slideshow.Description</p>

                @if (slideshow.Images?.Any() == true)
                {
                    <section class="slider-wrapper">
                        <div class="slider">
                            @{
                                var index = 0;
                            }
                            @foreach (var img in slideshow.Images.OrderBy(i => i.DisplayOrder))
                            {
                                var slideId = $"slide-{slideshow.Id}-{index}";
                                <img id="@slideId" src="@img.ImageUrl" alt="@img.Title" />
                                index++;
                            }
                        </div>

                        <div class="slider-nav">
                            @{
                                var indexNav = 0;
                            }
                            @foreach (var img in slideshow.Images.OrderBy(i => i.DisplayOrder))
                            {
                                var slideId = $"slide-{slideshow.Id}-{indexNav}";
                                <a href="#@slideId"></a>
                                indexNav++;
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    }
</div>

<style>
    .container {
        padding: 2rem;
    }

    .slider-wrapper {
        position: relative;
        max-width: 48rem;
        margin: auto;
    }

    .slider {
        display: flex;
        aspect-ratio: 16/9;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        box-shadow: 0 1.5rem 3rem -0.75rem hsla(0, 0%, 0%, 0.25);
        border-radius: 1rem;
        scrollbar-width: none;
    }

        .slider::-webkit-scrollbar {
            display: none; /* Chrome, Edge, Safari */
        }

        .slider img {
            flex: 1 0 100%;
            scroll-snap-align: start;
            object-fit: cover;
        }

    .slider-nav {
        display: flex;
        column-gap: 1rem;
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;

        /*dimmed background */
        background: rgba(0, 0, 0, 0.35);
        padding: 0.5rem 1rem;
        border-radius: 1rem;
        backdrop-filter: blur(4px);
    }

    

        .slider-nav a {
            width: 0.5rem;
            height: 0.5rem;
            background-color: #fff;
            border-radius: 50%;
            opacity: 0.75;
            transition: opacity 250ms ease;
            display: block;
        }

            .slider-nav a:hover {
                opacity: 1;
            }
</style>