@model OldWays.Models.Slideshow

@{
    ViewData["Title"] = "Delete Slideshow";
}

<div class="container mt-4">
    <h2>Delete Slideshow</h2>

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this slideshow?</strong>
        <br />
        This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Images</dt>
        <dd class="col-sm-9">@Model.Images.Count</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
