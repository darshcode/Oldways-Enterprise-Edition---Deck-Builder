@model OldWays.Models.SlideshowImage

@{
    ViewData["Title"] = "Delete Image";
}

<div class="container mt-4">
    <h2>Delete Image</h2>

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this image?</strong>
        <br />
        This action cannot be undone.
    </div>

    <div class="mb-3">
        <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-width: 300px;" />
    </div>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Alt Text</dt>
        <dd class="col-sm-9">@Model.AltText</dd>

        <dt class="col-sm-3">Display Order</dt>
        <dd class="col-sm-9">@Model.DisplayOrder</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SlideshowId" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Slideshow" asp-action="Edit" asp-route-id="@Model.SlideshowId" class="btn btn-secondary">Cancel</a>
    </form>
</div>
